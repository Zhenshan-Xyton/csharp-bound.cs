<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.9</RuntimeFrameworkVersion>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AssemblySearchPaths>{HintPathFromItem}</AssemblySearchPaths>
    <PinnedRuntimeDirectory>$(NetCoreRoot)shared/Microsoft.NETCore.App/$(RuntimeFrameworkVersion)</PinnedRuntimeDirectory>
    <RuntimeReferenceDirectory>$(PinnedRuntimeDirectory)</RuntimeReferenceDirectory>
    <RuntimeReferenceDirectory Condition="!Exists('$(PinnedRuntimeDirectory)/System.Private.CoreLib.dll')">$(MSBuildThisFileDirectory)runtime-refs</RuntimeReferenceDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Private.CoreLib">
      <HintPath>$(RuntimeReferenceDirectory)/System.Private.CoreLib.dll</HintPath>
    </Reference>
    <Reference Include="System.Runtime">
      <HintPath>$(RuntimeReferenceDirectory)/System.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="System.Collections">
      <HintPath>$(RuntimeReferenceDirectory)/System.Collections.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
